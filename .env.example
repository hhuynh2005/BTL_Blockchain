# ==========================================
# CẤU HÌNH MÔI TRƯỜNG DỰ ÁN ĐỊNH GIÁ TOKEN
# ==========================================

# 1. Ethereum RPC Endpoint (Infura / Alchemy / QuickNode)
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/demo_alchemy_api_key_placeholder

# 2. Etherscan API Key (Lấy dữ liệu on-chain, transaction, gas)
ETHERSCAN_KEY=YOUR_ETHERSCAN_API_KEY_HERE

# 3. Private Key ví Oracle Publisher (Deployer / Oracle node trên Sepolia testnet)
# LƯU Ý: KHÔNG commit file .env thật chứa private key lên Git!
PRIVATE_KEY=0x0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 4. Smart Contract Address đã deploy trên Sepolia Testnet
SEPOLIA_CONTRACT_ADDRESS=0x71C2E63B484e557297e68A7836376cFE94f06B0F

# 5. Tùy chọn chạy môi trường (development / production)
ENV_MODE=development
MOCK_ORACLE_IF_OFFLINE=true
